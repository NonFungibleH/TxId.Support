# Groq (free — https://console.groq.com)
GROQ_API_KEY=

# Voyage AI (embeddings — https://www.voyageai.com/)
VOYAGE_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Note: redirect URLs after sign-in/sign-up are set as props on <ClerkProvider> in layout.tsx
# Do NOT add NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL / AFTER_SIGN_UP_URL — deprecated in Clerk v5

# Blockchain (EVM)
# Per-chain RPC overrides, JSON keyed by chain id. Chains not listed keep their
# free public default, which has no key, no quota and no SLA. Set at least the
# chains your customers actually use.
# Keys accept a chain name or a hex id: "bnb", "bsc", "BNB Chain" and "0x38" all work.
# RPC_URLS={"bnb":"https://bnb.example.com/v2/KEY"}
RPC_URLS=

MORALIS_API_KEY=
# One Etherscan V2 key covers all EVM chains (Ethereum, Base, BSC, Polygon,
# Arbitrum, Optimism, Avalanche…). Get a free key at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Blockchain (Solana) — https://dev.helius.xyz
HELIUS_API_KEY=

# DexScreener — no key required (public API)

# Marketing site live widget (set to a publishable key to activate the live-AI toggle on /demo)
# Create a demo project in the app dashboard and paste its pk_ key here
NEXT_PUBLIC_DEMO_WIDGET_KEY=

# Email notifications for support tickets (optional — https://resend.com)
RESEND_API_KEY=

# Distributed rate limiting (optional — https://upstash.com, free tier)
# When both are set, the /api/chat limiter is enforced across all serverless
# instances. When unset, it falls back to a per-instance in-memory counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security — generate with: openssl rand -hex 32
# HMAC secret for signing outbound webhook payloads (X-TxID-Signature header)
WEBHOOK_SECRET=
# HMAC secret for signing short-lived dashboard preview tokens
PREVIEW_HMAC_SECRET=

# Widget publishable key — safe to expose client-side (prefixed NEXT_PUBLIC_)
# Used by PlatformWidget.tsx for embedded demos
NEXT_PUBLIC_PLATFORM_WIDGET_KEY=

# Admin console — comma-separated Clerk emails allowed to access /admin.
# REQUIRED for admin access: the guard is fail-closed, so if this is empty
# NOBODY can reach /admin or run admin actions. Must be set in Vercel prod too.
ADMIN_EMAILS=

# Billing (Stripe — https://dashboard.stripe.com)
# When STRIPE_SECRET_KEY + STRIPE_PRICE_PRO are set, the dashboard shows a
# live "Upgrade to Pro" checkout and billing portal; otherwise it falls back
# to the "email us" flow. Plan is only granted by the webhook, never client-side.
STRIPE_SECRET_KEY=
# Price ID of your recurring Pro product (price_..., created in the Stripe dashboard)
STRIPE_PRICE_PRO=
# Signing secret for the /api/stripe/webhook endpoint (whsec_..., from the
# webhook's "Signing secret" in the Stripe dashboard)
STRIPE_WEBHOOK_SECRET=

# App URLs (local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:3002
NEXT_PUBLIC_WIDGET_URL=http://localhost:3003

# ── Added by the 2026-08-11 launch audit: vars used in code but previously ──
# ── missing here. A fresh env built from this file silently shipped without ──
# ── the primary model key. ──

# Anthropic — PRIMARY model (Claude). Without it the app silently falls back
# to Groq/llama with worse answers and no error. REQUIRED in production.
ANTHROPIC_API_KEY=

# Cohere — alternative embeddings provider (Voyage is the default)
COHERE_API_KEY=

# Cron auth — REQUIRED: every /api/cron/* call must send Bearer $CRON_SECRET.
# Must be byte-identical between Vercel (app project) and the GitHub repo secret.
CRON_SECRET=

# AES-256-GCM key encrypting integration credentials in projects.config.
# Generate: openssl rand -base64 32. ABSENT = secrets stored in PLAINTEXT.
INTEGRATION_ENCRYPTION_KEY=

# Cloudflare Turnstile bot defence. The SECRET goes on the app project; the
# NEXT_PUBLIC site key goes on the web project. Unset = public surfaces have
# no bot check, silently.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Demo-key recognition, server-side on the app project (see CLAUDE.md: the
# robust exemption is the publicDemo config flag, not these).
DEMO_WIDGET_KEY=

# Aptos Build/Geomi API key — DEMO-CRITICAL: anonymous fullnode/indexer access
# rate-limits at 40k CU/300s per IP, which the Decibel demo hits.
APTOS_API_KEY=

# Aptos demo widget key for /check/aptos (web project)
NEXT_PUBLIC_APTOS_DEMO_WIDGET_KEY=
